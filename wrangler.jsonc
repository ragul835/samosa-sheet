{
  // The website is a Next.js static export. Deploy the generated files directly
  // instead of invoking the OpenNext server adapter.
  "name": "samosa-sheet",
  "compatibility_date": "2026-09-06",
  "routes": [
    { "pattern": "samosasheet.com", "custom_domain": true },
    { "pattern": "www.samosasheet.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
